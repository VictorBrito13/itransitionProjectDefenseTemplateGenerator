@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="min-h-[60vh] flex items-center justify-center bg-gray-50 px-4">
    <div class="w-full max-w-lg bg-white rounded-2xl shadow-soft p-8 md:p-12 text-center">
        <!-- Error Icon -->
        <div class="w-20 h-20 bg-error/10 rounded-full flex items-center justify-center mx-auto mb-6">
            <svg class="w-10 h-10 text-error" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
            </svg>
        </div>

        <!-- Error Heading -->
        <h1 class="text-2xl md:text-3xl font-bold text-gray-900 mb-2">Something went wrong</h1>
        <p class="text-gray-500 mb-8">An error occurred while processing your request. Please try again.</p>

        @if (Model.ShowRequestId)
        {
            <div class="bg-gray-50 rounded-xl p-4 mb-8 text-left">
                <p class="text-sm text-gray-500">
                    <span class="font-medium text-gray-700">Request ID:</span>
                    <code class="ml-2 text-sm bg-gray-200 px-2 py-0.5 rounded">@Model.RequestId</code>
                </p>
            </div>
        }

        <!-- Action Buttons -->
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
            <a asp-controller="Home" asp-action="Index" 
               class="inline-flex items-center justify-center px-6 py-3 bg-primary text-white font-medium rounded-xl hover:bg-primary-600 focus:ring-2 focus:ring-primary focus:ring-offset-2 transition-all duration-200">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                </svg>
                Go Home
            </a>
            <a asp-controller="Home" asp-action="Index"
               class="inline-flex items-center justify-center px-6 py-3 bg-white text-gray-700 font-medium rounded-xl border border-gray-200 hover:bg-gray-50 focus:ring-2 focus:ring-primary focus:ring-offset-2 transition-all duration-200">
                Try Again
            </a>
        </div>
    </div>
</div>

@if (Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest")
{
    <!-- Development mode info for AJAX requests -->
    <div class="hidden">
        @* Only visible in development environment *@
        @if (Model.ShowRequestId)
        {
            <p>Request ID: @Model.RequestId</p>
        }
    </div>
}

@* Development mode info remains from original template *@
<div class="hidden">
    @* The development environment info is kept for debugging but hidden from regular view *@
    <h3>Development Mode</h3>
    <p>
        Swapping to <strong>Development</strong> environment will display more detailed information...
    </p>
</div>
