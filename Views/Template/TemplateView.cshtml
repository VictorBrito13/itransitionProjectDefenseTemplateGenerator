@{
    ViewData["Title"] = "Template";
}

<div class="max-w-3xl mx-auto">
    <!-- Server messages -->
    <div id="server-msgs"></div>

    @{
        string errorMsg = (string) TempData["errorMsg"];
        string userEmail = (string) TempData["userEmail"];
        string userId = TempData["userId"].ToString();
        if(errorMsg != null) {
            <!-- Error displayed via toast notification -->
            <div class="hidden">
                <p>@errorMsg</p>
            </div>
        } else {
            <!-- Template Header -->
            <div id="form-header" class="bg-white rounded-2xl shadow-soft p-8 mb-6">
                <div class="flex items-start justify-between">
                    <div class="flex-1">
                        <h1 id="form-title" class="text-3xl font-bold text-gray-900"></h1>
                        <p id="form-description" class="text-gray-600 mt-2"></p>
                    </div>
                    <div id="likes-container" class="flex flex-col items-center gap-2 ml-6">
                        @{
                            if(userId != null) {
                                <span id="btn-log-out-container"></span>
                                <span id="likes-number" class="text-2xl font-bold text-gray-900">0</span>
                                <button class="flex items-center gap-2 px-4 py-2 border border-gray-200 rounded-lg hover:bg-yellow-50 hover:border-yellow-300 transition-colors" id="btn-like-template" data-like-action="like">
                                    <svg class="w-5 h-5 text-yellow-400" id="icon-star" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
                                    </svg>
                                    <svg class="w-5 h-5 text-yellow-400 hidden" id="icon-star-fill" fill="currentColor" viewBox="0 0 24 24">
                                        <path d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
                                    </svg>
                                </button>
                            }
                        }
                    </div>
                </div>
            </div>

            <!-- Response Form -->
            <div class="bg-white rounded-2xl shadow-soft p-8">
                <!-- Progress bar -->
                <div class="w-full bg-gray-200 rounded-full h-2 mb-2">
                    <div id="progress-bar" class="bg-primary h-2 rounded-full transition-all duration-300" style="width: 0%"></div>
                </div>
                <p id="progress-text" class="text-sm text-gray-500 mb-8">0 of 0 questions answered</p>

                <form id="form-questions">
                    <div class="space-y-6">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
                            <input type="email" class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:ring-2 focus:ring-primary focus:border-primary bg-gray-50" name="email" id="form-user-email" data-userid="@userId" value="@userEmail" disabled>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Date</label>
                            <input type="datetime-local" class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:ring-2 focus:ring-primary focus:border-primary bg-gray-50" name="date" id="form-date" disabled>
                        </div>
                    </div>
                </form>

                <!-- Submit Section -->
                <div class="mt-8 flex justify-end" id="submit-section">
                    <button id="btn-submit" type="button"
                            class="px-8 py-3 bg-primary text-white font-medium rounded-lg hover:bg-blue-600 transition-colors focus:ring-2 focus:ring-primary focus:ring-offset-2">
                        Submit Response
                    </button>
                </div>
            </div>

            <!-- Success State (hidden by default) -->
            <div id="success-state" class="hidden text-center py-16 bg-white rounded-2xl shadow-soft mt-6">
                <div class="w-16 h-16 bg-secondary/10 rounded-full flex items-center justify-center mx-auto mb-4">
                    <svg class="w-8 h-8 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                </div>
                <h2 class="text-2xl font-bold text-gray-900 mb-2">Thank you for your response!</h2>
                <p class="text-gray-600">Your response has been recorded.</p>
            </div>
        }
    }

    @await Html.PartialAsync("_ToastPartial")

    <script src="~/js/templateView/templateView.js" type="module"></script>
</div>
